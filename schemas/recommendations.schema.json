{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AlphaPulseRecommendationsSchema",
  "description": "Schema for Alpha Pulse Vietnam Quantitative Stock Recommendations v2.0",
  "type": "object",
  "required": [
    "schema_version",
    "generated_at",
    "source_date",
    "market",
    "summary",
    "recommendations"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "2.0"
    },
    "generated_at": {
      "type": "string"
    },
    "source_date": {
      "type": "string"
    },
    "market": {
      "type": "object",
      "required": ["regime", "confidence", "metrics"],
      "properties": {
        "regime": {
          "type": "string",
          "enum": ["STRONG_BULL", "BULL", "DEFENSIVE", "BEAR", "PANIC"]
        },
        "confidence": {
          "type": ["number", "null"]
        },
        "regime_score": {
          "type": ["number", "null"]
        },
        "metrics": {
          "type": "object",
          "required": ["vnindex_value", "vnindex_change_pct"],
          "properties": {
            "vnindex_value": { "type": ["number", "null"] },
            "vnindex_change_pct": { "type": ["number", "null"] },
            "vn30_change_pct": { "type": ["number", "null"] },
            "market_breadth_ratio": { "type": ["number", "null"] },
            "volatility": { "type": ["number", "null"] },
            "volume_20d_ratio": { "type": ["number", "null"] }
          }
        }
      }
    },
    "summary": {
      "type": "object",
      "required": [
        "total_scanned",
        "buy_count",
        "watch_count",
        "hold_count",
        "sell_count",
        "avoid_count"
      ],
      "properties": {
        "total_scanned": { "type": "integer" },
        "buy_count": { "type": "integer" },
        "watch_count": { "type": "integer" },
        "hold_count": { "type": "integer" },
        "sell_count": { "type": "integer" },
        "avoid_count": { "type": "integer" }
      }
    },
    "recommendations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/recommendation"
      }
    }
  },
  "$defs": {
    "recommendation": {
      "type": "object",
      "required": [
        "symbol",
        "company_name",
        "exchange",
        "sector",
        "action",
        "alpha_score",
        "risk_adjusted_alpha",
        "risk_level",
        "expected_return",
        "risk_metrics",
        "trade_plan",
        "reasons",
        "warnings"
      ],
      "properties": {
        "symbol": { "type": "string" },
        "company_name": { "type": "string" },
        "exchange": { "type": "string", "enum": ["HOSE", "HNX", "UPCOM"] },
        "sector": { "type": "string" },
        "action": {
          "type": "string",
          "enum": ["BUY", "WATCH", "HOLD", "SELL", "AVOID"]
        },
        "alpha_score": { "type": ["number", "null"] },
        "risk_adjusted_alpha": { "type": ["number", "null"] },
        "risk_level": {
          "type": ["string", "null"],
          "enum": ["LOW", "MEDIUM", "HIGH", null]
        },
        "expected_return": {
          "type": "object",
          "required": ["expected_return_5d", "expected_return_10d", "expected_return_20d"],
          "properties": {
            "expected_return_5d": { "type": ["number", "null"] },
            "expected_return_10d": { "type": ["number", "null"] },
            "expected_return_20d": { "type": ["number", "null"] }
          }
        },
        "risk_metrics": {
          "type": "object",
          "required": ["var_t25", "es_t25", "volatility_60d", "max_drawdown", "liquidity_score"],
          "properties": {
            "var_t25": { "type": ["number", "null"] },
            "es_t25": { "type": ["number", "null"] },
            "volatility_60d": { "type": ["number", "null"] },
            "max_drawdown": { "type": ["number", "null"] },
            "liquidity_score": { "type": ["number", "null"] }
          }
        },
        "trade_plan": {
          "type": "object",
          "required": [
            "current_price",
            "entry_low",
            "entry_high",
            "stop_loss",
            "tp1",
            "tp2",
            "risk_reward",
            "position_percent"
          ],
          "properties": {
            "current_price": { "type": ["number", "null"] },
            "entry_low": { "type": ["number", "null"] },
            "entry_high": { "type": ["number", "null"] },
            "stop_loss": { "type": ["number", "null"] },
            "tp1": { "type": ["number", "null"] },
            "tp2": { "type": ["number", "null"] },
            "risk_reward": { "type": ["number", "null", "string"] },
            "position_percent": { "type": ["number", "null"] }
          }
        },
        "reasons": {
          "type": "array",
          "items": { "type": "string" }
        },
        "warnings": {
          "type": "array",
          "items": { "type": "string" }
        },
        "divergence": {
          "type": ["object", "null"]
        }
      }
    }
  }
}
