{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AlphaPulseRecommendationsSchema",
  "description": "Schema for Alpha Pulse Quantitative Stock Recommendations v3.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "market",
    "market_date",
    "generated_at",
    "data_quality",
    "market_context",
    "summary",
    "recommendations"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "3.0"
    },
    "market": {
      "type": "string",
      "const": "VN"
    },
    "market_date": {
      "type": "string"
    },
    "generated_at": {
      "type": "string"
    },
    "data_quality": {
      "$ref": "#/$defs/data_quality"
    },
    "universe_info": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "universe_type": { "type": "string" },
        "universe_size": { "type": "integer" },
        "version": { "type": "integer" }
      }
    },
    "market_context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["regime", "confidence", "metrics"],
      "properties": {
        "regime": {
          "type": "string",
          "enum": ["STRONG_BULL", "BULL", "DEFENSIVE", "BEAR", "PANIC"]
        },
        "regime_score": {
          "type": ["number", "null"],
          "minimum": 0.0,
          "maximum": 100.0
        },
        "confidence": {
          "type": ["number", "null"],
          "minimum": 0.0,
          "maximum": 1.0
        },
        "metrics": {
          "type": "object",
          "additionalProperties": false,
          "required": ["vnindex_value", "vnindex_change_pct"],
          "properties": {
            "vnindex_value": { "type": ["number", "null"] },
            "vnindex_change_pct": { "type": ["number", "null"] },
            "vn30_change_pct": { "type": ["number", "null"] },
            "market_breadth_ratio": {
              "type": ["number", "null"],
              "minimum": 0.0,
              "maximum": 1.0
            },
            "volatility": { "type": ["number", "null"] },
            "volume_20d_ratio": { "type": ["number", "null"] }
          }
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "total_scanned",
        "buy_count",
        "watch_count",
        "hold_count",
        "sell_count",
        "avoid_count"
      ],
      "properties": {
        "total_scanned": { "type": "integer" },
        "buy_count": { "type": "integer" },
        "watch_count": { "type": "integer" },
        "hold_count": { "type": "integer" },
        "sell_count": { "type": "integer" },
        "avoid_count": { "type": "integer" }
      }
    },
    "recommendations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/recommendation"
      }
    }
  },
  "$defs": {
    "data_quality": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "source", "market_date", "is_stale"],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["REAL", "CACHE", "SYNTHETIC"]
        },
        "source": { "type": "string" },
        "market_date": { "type": "string" },
        "is_stale": { "type": "boolean" }
      }
    },
    "recommendation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "symbol",
        "company_name",
        "exchange",
        "sector",
        "signal",
        "score",
        "confidence",
        "market_regime",
        "risk",
        "trade_plan",
        "data_quality",
        "reasons",
        "warnings"
      ],
      "properties": {
        "symbol": { "type": "string" },
        "company_name": { "type": "string" },
        "exchange": { "type": "string", "enum": ["HOSE", "HNX", "UPCOM"] },
        "sector": { "type": "string" },
        "signal": {
          "type": "string",
          "enum": ["BUY", "WATCH", "HOLD", "SELL", "AVOID"]
        },
        "score": {
          "type": ["number", "null"],
          "minimum": 0.0,
          "maximum": 100.0
        },
        "confidence": {
          "type": ["number", "null"],
          "minimum": 0.0,
          "maximum": 1.0
        },
        "market_regime": {
          "type": "string",
          "enum": ["STRONG_BULL", "BULL", "DEFENSIVE", "BEAR", "PANIC"]
        },
        "risk": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "risk_level",
            "var_t25",
            "es_t25",
            "volatility_60d",
            "max_drawdown",
            "liquidity_score"
          ],
          "properties": {
            "risk_level": {
              "type": ["string", "null"],
              "enum": ["LOW", "MEDIUM", "HIGH", null]
            },
            "var_t25": { "type": ["number", "null"] },
            "es_t25": { "type": ["number", "null"] },
            "volatility_60d": { "type": ["number", "null"] },
            "max_drawdown": { "type": ["number", "null"] },
            "liquidity_score": {
              "type": ["number", "null"],
              "minimum": 0.0,
              "maximum": 100.0
            },
            "avg_value_20d": { "type": ["number", "null"] }
          }
        },
        "trade_plan": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "signal_date",
            "execution_date",
            "settlement_date",
            "settlement_model",
            "current_price",
            "entry_low",
            "entry_high",
            "stop_loss",
            "tp1",
            "tp2",
            "risk_reward",
            "position_percent"
          ],
          "properties": {
            "signal_date": { "type": "string" },
            "execution_date": { "type": "string" },
            "settlement_date": { "type": "string" },
            "settlement_model": { "type": "string", "const": "T+2.5" },
            "current_price": { "type": ["number", "null"] },
            "entry_low": { "type": ["number", "null"] },
            "entry_high": { "type": ["number", "null"] },
            "stop_loss": { "type": ["number", "null"] },
            "tp1": { "type": ["number", "null"] },
            "tp2": { "type": ["number", "null"] },
            "risk_reward": { "type": ["number", "null"] },
            "position_percent": {
              "type": ["number", "null"],
              "minimum": 0.0,
              "maximum": 100.0
            }
          }
        },
        "data_quality": {
          "$ref": "#/$defs/data_quality"
        },
        "reasons": {
          "type": "array",
          "items": { "type": "string" }
        },
        "warnings": {
          "type": "array",
          "items": { "type": "string" }
        },
        "divergence": {
          "type": ["object", "null"]
        }
      }
    }
  }
}
